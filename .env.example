# Copia este archivo a `.env` y rellena con los valores de tu proyecto de Supabase.
# Solo variables PUBLIC_* (se incrustan en el bundle del cliente): nunca pongas aquí
# la service role key ni otros secretos.

# Supabase → Project Settings → API
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clave pública VAPID para las notificaciones push (opcional en desarrollo)
PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
